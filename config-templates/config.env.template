REM ============================================================
REM  EPM Automate Toolkit - Environment Configuration Template
REM ============================================================
REM  Copy this file to config.env (in repo root) and fill in
REM  your actual values. config.env is gitignored so your
REM  credentials never get committed.
REM
REM  Usage: All batch scripts source this file at startup.
REM ============================================================

REM ---- EPM Cloud Connection ----
SET EPM_URL=https://your-pod.oraclecloud.com
SET EPM_USER=service.account@example.com
SET EPM_DOMAIN=your-identity-domain
SET PASSWORD_FILE=C:\epm\secure\password.epw

REM ---- Local Paths ----
SET LOG_DIR=C:\epm\logs
SET BACKUP_DIR=C:\epm\backups
SET LCM_DIR=C:\epm\lcm-exports
SET DATA_DIR=C:\epm\data-files
SET METADATA_DIR=C:\epm\metadata-files

REM ---- Retention (days) ----
SET BACKUP_RETENTION_DAYS=14
SET LOG_RETENTION_DAYS=30

REM ---- Application Settings ----
SET SNAPSHOT_NAME=Artifact Snapshot
SET APPLICATION_NAME=YourAppName
